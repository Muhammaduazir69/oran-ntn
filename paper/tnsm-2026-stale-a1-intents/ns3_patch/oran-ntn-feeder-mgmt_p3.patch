         {
-            rcBeam.erase(rcBeam.begin());
+            x += ex();
         }
+        return T * x / k;
+    }
+    if (g.beamCv2 > 1.0)
+    {
+        const double p1 = 0.5 * (1.0 + std::sqrt((g.beamCv2 - 1.0) / (g.beamCv2 + 1.0)));
+        const bool first = rvBeam->GetValue() < p1;
+        return ex() * (first ? T / (2.0 * p1) : T / (2.0 * (1.0 - p1)));
